cabal-version:  3.0
name:           caraml-lang
version:        0.1.0
synopsis:       CaraML compiler and tools.
build-type:     Simple

library caraml-lang-verified
  hs-source-dirs:   verified
  exposed-modules:  CaraML.Verified
  build-depends:    base, containers
  default-language: Haskell2010
  ghc-options:      -Wno-tabs

common shared
  default-language: GHC2021
  default-extensions:
      DuplicateRecordFields
      LambdaCase
      NoFieldSelectors
      OverloadedRecordDot
      OverloadedStrings
  ghc-options:      -Wall -Werror
  build-depends:
      base       >=4.14 && <5,
      containers,
      text
  other-modules:    Paths_caraml_lang
  autogen-modules:  Paths_caraml_lang

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      CaraML.Build.Fetch
      CaraML.Build.Project
      CaraML.Cli
      CaraML.Commands
      CaraML.Commands.Build
      CaraML.Commands.Compile
      CaraML.Commands.Fmt
      CaraML.Commands.Lsp
      CaraML.Language
      CaraML.Lsp.Abbreviations
      CaraML.Lsp.Docs
      CaraML.Lsp.Handlers
      CaraML.Lsp.JsonRpc
      CaraML.Lsp.Server
  other-modules:
      CaraML.Unverified
  build-depends:
      aeson      >=2.0,
      caraml-lang-verified,
      bytestring,
      cryptohash-sha256,
      directory,
      filepath,
      process,
      text-rope  >=0.3,
      mtl,
      stm
  build-tool-depends: autoexporter:autoexporter

executable caraml
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N2"
  build-depends:
    caraml-lang,
    optparse-applicative >=0.18

