cabal-version:  3.0
name:           caraml
version:        0.1.0
synopsis:       CaraML compiler and tools.
build-type:     Simple

library caraml-verified
  hs-source-dirs:   verified
  exposed-modules:  CaraML.Verified
  build-depends:    base, containers
  default-language: Haskell2010
  ghc-options:      -Wno-tabs

executable caraml
  main-is:          Main.hs
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:      -Wall -threaded -rtsopts "-with-rtsopts=-N2"
  other-modules:
      CaraML.Commands.Check
      CaraML.Commands.Compile
      CaraML.Commands.Fmt
      CaraML.Commands.Lsp
      CaraML.Commands
      CaraML.Cli
      CaraML.Lsp.Abbreviations
      CaraML.Lsp.Docs
      CaraML.Lsp.Handlers
      CaraML.Lsp.JsonRpc
      CaraML.Lsp.Server
      Paths_caraml
  autogen-modules:  Paths_caraml
  build-depends:
      base       >=4.14 && <5,
      aeson      >=2.0,
      caraml-verified,
      bytestring,
      containers,
      text,
      text-rope  >=0.3,
      mtl,
      stm
  build-tool-depends: autoexporter:autoexporter
