cabal-version:  3.0
name:           caraml
version:        0.1.0
license:        BSD-3-Clause
license-file:   LICENSE
category:       Compiler, Development
maintainer:     Basil Fürer <fuererb@protonmail.com>
synopsis:       CaraML compiler and tools.
homepage:       https://caraml-lang.org
bug-reports:    https://github.com/b4er/caraml/issues
build-type:     Simple
description:
  The @caraml@ command line tool for CaraML, a strict functional programming
  language in the ML family with modular implicits. The commands, build system
  and language server are built on top of the library @caraml-verified@ which is
  generated from the Isabelle/HOL formalisation of the language.

source-repository head
  type:     git
  location: https://github.com/b4er/caraml
  subdir:   haskell

flag werror
  description: Turn warnings into errors.
  default:     False
  manual:      True

library caraml-verified
  hs-source-dirs:   verified
  exposed-modules:  CaraML.Verified
  build-depends:   
    base >=4.14 && <5,
    containers >=0.6 && <0.9
  default-language: Haskell2010
  ghc-options:      -Wno-tabs

common shared
  default-language: GHC2021
  default-extensions:
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:      -Wall
  if flag(werror)
    ghc-options:    -Werror
  build-depends:
    base       >=4.14 && <5,
    containers >=0.6  && <0.9,
    text       >=2.0  && <2.2
  other-modules:    Paths_caraml
  autogen-modules:  Paths_caraml

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      CaraML.Build.Fetch
      CaraML.Build.Project
      CaraML.Cli
      CaraML.Commands
      CaraML.Commands.Build
      CaraML.Commands.Compile
      CaraML.Commands.Fmt
      CaraML.Commands.Lsp
      CaraML.Language
      CaraML.Lsp.Abbreviations
      CaraML.Lsp.Docs
      CaraML.Lsp.Handlers
      CaraML.Lsp.JsonRpc
      CaraML.Lsp.Server
  other-modules:
      CaraML.Unverified
  build-depends:
      aeson             >=2.0   && <2.3,
      caraml-verified,
      bytestring        >=0.11  && <0.13,
      cryptohash-sha256 >=0.11  && <0.12,
      directory         >=1.3   && <1.4,
      filepath          >=1.4   && <1.6,
      process           >=1.6   && <1.7,
      text-rope         >=0.3   && <0.4,
      mtl               >=2.3   && <2.4,
      stm               >=2.5   && <2.6
  build-tool-depends: autoexporter:autoexporter

executable caraml
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N2"
  build-depends:
    caraml,
    optparse-applicative >=0.18 && <0.20

