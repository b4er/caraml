# generate abbreviation tables for VS Code, Emacs and the server
{ lib, runCommand }:

let
  table = map
    (line:
      let row = lib.splitString "\t" line;
      in { name = lib.elemAt row 0; symbol = lib.elemAt row 1; })
    (lib.filter (l: l != "") (lib.splitString "\n" (builtins.readFile ./abbreviations.tsv)));

  generated = "Generated by editors/abbreviations.nix, do not edit.";

  ts = ''
    // ${generated}

    export const abbreviations: ReadonlyMap<string, string> = new Map([
    ${lib.concatMapStrings (r: "  ['${r.name}', '${r.symbol}'],\n") table}]);
  '';

  el = ''
    ;;; caraml-input.el --- input method for CaraML symbols -*- lexical-binding: t; -*-
    ;;; Commentary:
    ;; ${generated}
    ;;; Code:

    (require 'quail)

    (quail-define-package
     "caraml" "UTF-8" "∘" t
     "CaraML symbols by backslash abbreviation: \\alpha, \\to, \\le, \\circ."
     nil t nil nil nil nil t)

    (quail-define-rules
    ${lib.concatMapStringsSep "\n" (r: " (\"\\\\${r.name}\" ?${r.symbol})") table})

    (provide 'caraml-input)
    ;;; caraml-input.el ends here
  '';

  hs = ''
    {-# LANGUAGE OverloadedStrings #-}
    -- ${generated}
    module CaraML.Lsp.Abbreviations (abbreviations) where

    import Data.Text (Text)

    abbreviations :: [(Text, Text)]
    abbreviations =
    ${lib.concatImapStrings
      (i: r: "  ${if i == 1 then "[" else ","} (\"${r.name}\", \"${r.symbol}\")\n") table}  ]
  '';
in
runCommand "caraml-abbreviations"
  {
    inherit ts el hs;
    passAsFile = [ "ts" "el" "hs" ];
  }
  ''
    install -Dm644 $tsPath $out/editors/vscode/src/abbreviations.ts
    install -Dm644 $elPath $out/editors/emacs/local/caraml-mode/caraml-input.el
    install -Dm644 $hsPath $out/haskell/src/CaraML/Lsp/Abbreviations.hs
  ''
